{
  "name": "memcastle-pi",
  "private": true,
  "description": "MemCastle lifecycle extension for Pi, over MCP and HTTP only",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": ["./dist/extension.js"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "python3 scripts/build_integration.py",
    "format:check": "bunx prettier --check src test",
    "lint": "npm run typecheck",
    "test": "bun test --timeout 60000",
    "test:cover": "bun test --timeout 60000 --coverage --coverage-reporter=lcov --coverage-dir=coverage"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-mcp": "^1.0.2",
    "smol-toml": "^1.9.0"
  }
}
